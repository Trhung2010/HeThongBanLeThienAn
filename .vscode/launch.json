{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/HeThongBanLeThienAn.API/bin/Debug/net8.0/HeThongBanLeThienAn.API.dll",
      "cwd": "${workspaceFolder}/HeThongBanLeThienAn.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7163;http://localhost:5167"
      },
      "preLaunchTask": "API: prepare"
    },
    {
      "name": "WinForms Client (API HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/HeThongBanLeThienAn.WinForms/bin/Debug/net8.0-windows/HeThongBanLeThienAn.WinForms.dll",
      "cwd": "${workspaceFolder}/HeThongBanLeThienAn.WinForms"
    }
  ],
  "compounds": [
    {
      "name": "API + WinForms",
      "configurations": ["API (HTTPS)", "WinForms Client (API HTTPS)"],
      "stopAll": true
    }
  ]
}
